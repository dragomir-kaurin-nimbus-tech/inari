# Public site URL (update when you connect a real domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification meta (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_token_here

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact form messages are delivered (change to your inbox later)
CONTACT_TO_EMAIL=test@example.com

# Resend test sender until you verify your own domain
CONTACT_FROM_EMAIL=onboarding@resend.dev
