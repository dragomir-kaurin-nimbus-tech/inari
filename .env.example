# Production domain (also set this on Vercel)
NEXT_PUBLIC_SITE_URL=https://inaridesign.rs

# Google Search Console — token only (from google-site-verification=...)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_token_here

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact form messages are delivered
CONTACT_TO_EMAIL=inari.design2022@gmail.com

# Empty until you verify your own sending domain in Resend
CONTACT_FROM_EMAIL=
